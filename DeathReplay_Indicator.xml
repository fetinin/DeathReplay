<?xml version="1.0" encoding="UTF-8"?>
<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
    <Scripts>
        <Script file="DeathReplay_Indicator.lua"/>
    </Scripts>
    <Assets>
        <Texture name="DeathReplaySkull" file="skull.tga"/>
    </Assets>
    <Windows>
        <Window name="DeathReplay_Indicator" inherits="EA_Window_Default" movable="true" handleinput="true" savesettings="true" layer="default">
            <Size>
                <AbsPoint x="48" y="48" />
            </Size>
            <Anchors>
                <Anchor point="topleft" relativeTo="Root" relativePoint="topleft">
                    <AbsPoint x="200" y="200" />
                </Anchor>
            </Anchors>
            <EventHandlers>
                <EventHandler event="OnLButtonUp" function="DeathReplayIndicator.OnClick" />
                <EventHandler event="OnMouseOver" function="DeathReplayIndicator.OnMouseOver" />
                <EventHandler event="OnInitialize" function="DeathReplayIndicator.OnWindowInit" />
            </EventHandlers>
            <Windows>
                <DynamicImage name="$parentIcon" texture="DeathReplaySkull" textureScale="0.75" handleinput="false" layer="default">
                    <Size>
                        <AbsPoint x="48" y="48"/>
                    </Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                            <AbsPoint x="0" y="0"/>
                        </Anchor>
                    </Anchors>
                </DynamicImage>
            </Windows>
        </Window>
    </Windows>
</Interface>
