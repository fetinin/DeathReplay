<?xml version="1.0" encoding="UTF-8"?>
<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Windows>
        <Window name="DeathReplay_Indicator" inherits="EA_Window_Default" movable="true" handleinput="true" savesettings="true" layer="overlay">
            <Size>
                <AbsPoint x="48" y="48" />
            </Size>
            <Anchors>
                <Anchor point="topleft" relativeTo="Root" relativePoint="topleft">
                    <AbsPoint x="200" y="200" />
                </Anchor>
            </Anchors>
            <EventHandlers>
                <EventHandler event="OnLButtonUp" function="DeathReplayIndicator.OnClick" />
                <EventHandler event="OnMouseOver" function="DeathReplayIndicator.OnMouseOver" />
                <EventHandler event="OnInitialize" function="DeathReplayIndicator.OnWindowInit" />
            </EventHandlers>
            <Windows>
                <FullResizeImage name="$parentBackground" inherits="EA_FullResizeImage_MetalFill">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                            <AbsPoint x="0" y="0"/>
                        </Anchor>
                        <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
                            <AbsPoint x="0" y="0"/>
                        </Anchor>
                    </Anchors>
                </FullResizeImage>
            </Windows>
        </Window>
    </Windows>
</Interface>
