<?xml version="1.0" encoding="UTF-8"?>
<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../Interface.xsd">
    <Scripts>
        <Script file="DeathReplay_GUI.lua"/>
    </Scripts>
    <Windows>
        <Window name="DeathReplay_GUI" movable="true" handleinput="true" savesettings="true" layer="popup">
            <Size>
                <AbsPoint x="480" y="420" />
            </Size>
            <Anchors>
                <Anchor point="center" relativePoint="center" relativeTo="">
                    <AbsPoint x="0" y="0"/>
                </Anchor>
            </Anchors>
            <Windows>
                <Window name="$parentBackground" inherits="EA_Window_DefaultFrame">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                            <AbsPoint x="0" y="32"/>
                        </Anchor>
                        <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
                            <AbsPoint x="0" y="0"/>
                        </Anchor>
                    </Anchors>
                </Window>

                <Window name="$parentTitleBar" inherits="EA_TitleBar_Default"/>

                <Button name="$parentClose" inherits="EA_Button_DefaultWindowClose">
                    <EventHandlers>
                        <EventHandler event="OnLButtonUp" function="DeathReplay_GUI.OnClose"/>
                    </EventHandlers>
                </Button>

                <Window name="$parentFooter" inherits="EA_Window_DefaultButtonBottomFrame" layer="background">
                    <Size><AbsPoint x="0" y="56" /></Size>
                </Window>

                <Button name="$parentFilterDmg" inherits="EA_Button_DefaultCheckBox" layer="popup">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground">
                            <AbsPoint x="20" y="14" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnLButtonUp" function="DeathReplay_GUI.OnToggleDmg"/>
                    </EventHandlers>
                </Button>

                <Label name="$parentFilterDmgLabel" font="font_default_text" inherits="DefaultWindowText" handleinput="false" textalign="left" wordwrap="false">
                    <Size><AbsPoint x="70" y="20" /></Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground">
                            <AbsPoint x="50" y="16" />
                        </Anchor>
                    </Anchors>
                </Label>

                <Button name="$parentFilterBuffs" inherits="EA_Button_DefaultCheckBox" layer="popup">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground">
                            <AbsPoint x="140" y="14" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnLButtonUp" function="DeathReplay_GUI.OnToggleBuffs"/>
                    </EventHandlers>
                </Button>

                <Label name="$parentFilterBuffsLabel" font="font_default_text" inherits="DefaultWindowText" handleinput="false" textalign="left" wordwrap="false">
                    <Size><AbsPoint x="60" y="20" /></Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground">
                            <AbsPoint x="170" y="16" />
                        </Anchor>
                    </Anchors>
                </Label>

                <Label name="$parentNavLabel" font="font_default_text" inherits="DefaultWindowText" handleinput="false" textalign="left" wordwrap="false">
                    <Size><AbsPoint x="440" y="20" /></Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground">
                            <AbsPoint x="20" y="46" />
                        </Anchor>
                    </Anchors>
                </Label>

                <Label name="$parentTimeline" font="font_chat_text" inherits="DefaultWindowText" handleinput="false" textalign="left" wordwrap="true">
                    <Size><AbsPoint x="448" y="200" /></Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground">
                            <AbsPoint x="20" y="74" />
                        </Anchor>
                    </Anchors>
                </Label>

                <Button name="$parentPrev" inherits="EA_Button_DefaultResizeable" layer="popup">
                    <Anchors>
                        <Anchor point="bottomleft" relativePoint="bottomleft" relativeTo="$parent">
                            <AbsPoint x="0" y="-4" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnLButtonUp" function="DeathReplay_GUI.OnPrev"/>
                    </EventHandlers>
                </Button>

                <Button name="$parentNext" inherits="EA_Button_DefaultResizeable" layer="popup">
                    <Anchors>
                        <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
                            <AbsPoint x="0" y="-4" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnLButtonUp" function="DeathReplay_GUI.OnNext"/>
                    </EventHandlers>
                </Button>
            </Windows>
        </Window>
    </Windows>
</Interface>
