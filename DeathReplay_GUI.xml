<?xml version="1.0" encoding="UTF-8"?>
<Interface xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Windows>
        <Window name="DeathReplay_GUI" inherits="EA_Window_Default" movable="true" handleinput="true" savesettings="true" layer="popup">
            <Size>
                <AbsPoint x="480" y="420" />
            </Size>
            <Anchors>
                <Anchor point="center" relativeTo="Root" relativePoint="center"/>
            </Anchors>
            <Windows>
                <FullResizeImage name="$parentBackground" inherits="EA_FullResizeImage_MetalFill">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parent">
                            <AbsPoint x="0" y="0"/>
                        </Anchor>
                        <Anchor point="bottomright" relativePoint="bottomright" relativeTo="$parent">
                            <AbsPoint x="0" y="0"/>
                        </Anchor>
                    </Anchors>
                </FullResizeImage>

                <Label name="$parentTitle" font="font_default_text" inherits="DefaultWindowText" handleinput="false" textalign="left" wordwrap="false">
                    <Size><AbsPoint x="400" y="24" /></Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground">
                            <AbsPoint x="20" y="14" />
                        </Anchor>
                    </Anchors>
                </Label>

                <Label name="$parentNavLabel" font="font_default_text" inherits="DefaultWindowText" handleinput="false" textalign="left" wordwrap="false">
                    <Size><AbsPoint x="440" y="20" /></Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground">
                            <AbsPoint x="20" y="44" />
                        </Anchor>
                    </Anchors>
                </Label>

                <Button name="$parentPrev" inherits="EA_Button_DefaultResizeable" layer="popup">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground">
                            <AbsPoint x="20" y="78" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnLButtonUp" function="DeathReplay_GUI.OnPrev"/>
                    </EventHandlers>
                </Button>

                <Button name="$parentNext" inherits="EA_Button_DefaultResizeable" layer="popup">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground">
                            <AbsPoint x="100" y="78" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnLButtonUp" function="DeathReplay_GUI.OnNext"/>
                    </EventHandlers>
                </Button>

                <Button name="$parentFilterDmg" inherits="EA_Button_DefaultCheckBox" layer="popup">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground">
                            <AbsPoint x="200" y="78" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnLButtonUp" function="DeathReplay_GUI.OnToggleDmg"/>
                    </EventHandlers>
                </Button>

                <Button name="$parentFilterBuffs" inherits="EA_Button_DefaultCheckBox" layer="popup">
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground">
                            <AbsPoint x="300" y="78" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnLButtonUp" function="DeathReplay_GUI.OnToggleBuffs"/>
                    </EventHandlers>
                </Button>

                <Button name="$parentClose" inherits="EA_Button_DefaultResizeable" layer="popup">
                    <Anchors>
                        <Anchor point="topright" relativePoint="topright" relativeTo="$parentBackground">
                            <AbsPoint x="-12" y="14" />
                        </Anchor>
                    </Anchors>
                    <EventHandlers>
                        <EventHandler event="OnLButtonUp" function="DeathReplay_GUI.OnClose"/>
                    </EventHandlers>
                </Button>

                <Label name="$parentTimeline" font="font_chat_text" inherits="DefaultWindowText" handleinput="false" textalign="left" wordwrap="true">
                    <Size><AbsPoint x="440" y="280" /></Size>
                    <Anchors>
                        <Anchor point="topleft" relativePoint="topleft" relativeTo="$parentBackground">
                            <AbsPoint x="20" y="120" />
                        </Anchor>
                    </Anchors>
                </Label>
            </Windows>
        </Window>
    </Windows>
</Interface>
